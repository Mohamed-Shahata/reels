NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://podcast:podcast@localhost:5432/podcast_reels
REDIS_URL=redis://localhost:6379
CORS_ORIGIN=http://localhost:3000
COOKIE_SAME_SITE=lax
JWT_ACCESS_SECRET=
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_SEC=2592000
AUTH_RATE_LIMIT_TTL_SEC=60
AUTH_RATE_LIMIT_MAX=10
GROQ_API_KEY=
GROQ_SEGMENTATION_MODEL=openai/gpt-oss-20b
SEGMENTATION_WINDOW_MAX_CHARS=6000
SEGMENTATION_WINDOW_OVERLAP_SEC=30
SEGMENTATION_MAX_COMPLETION_TOKENS=3000
SEGMENTATION_CONCURRENCY=1
SEGMENTATION_VALIDATION_MAX_ATTEMPTS=3
SEGMENTATION_MONTHLY_RUN_LIMIT=20
VIDEO_ALLOWED_FORMATS=mp4,mov,webm
VIDEO_MAX_SIZE_BYTES=5368709120
VIDEO_MAX_DURATION_SEC=14400
CLIP_MIN_DURATION_SEC=5
CLIP_MAX_DURATION_SEC=240
AI_CLIP_MIN_DURATION_SEC=60
AI_CLIP_MAX_DURATION_SEC=240
STALE_UPLOAD_THRESHOLD_SEC=86400
STALE_UPLOAD_CLEANUP_INTERVAL_SEC=3600

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# Object Storage (S3 / MinIO / R2)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=reels-media
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# Worker & Processing
WORKDIR_ROOT=storage/tmp
WORKER_CONCURRENCY_RENDER=1
WORKER_CONCURRENCY_TRANSCRIBE=2
RENDER_RETENTION_DAYS=14
DOWNLOAD_URL_TTL_SEC=300
ANALYZER_TIMEOUT_MS=60000


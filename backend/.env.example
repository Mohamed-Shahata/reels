NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://podcast:podcast@localhost:5432/podcast_reels
REDIS_URL=redis://localhost:6379
CORS_ORIGIN=http://localhost:3000
COOKIE_SAME_SITE=lax
JWT_ACCESS_SECRET=
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_SEC=2592000
AUTH_RATE_LIMIT_TTL_SEC=60
AUTH_RATE_LIMIT_MAX=10
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=podcast-reels
GROQ_API_KEY=
GROQ_SEGMENTATION_MODEL=openai/gpt-oss-20b
SEGMENTATION_WINDOW_MAX_CHARS=6000
SEGMENTATION_WINDOW_OVERLAP_SEC=30
SEGMENTATION_MAX_COMPLETION_TOKENS=3000
SEGMENTATION_CONCURRENCY=1
SEGMENTATION_VALIDATION_MAX_ATTEMPTS=3
VIDEO_ALLOWED_FORMATS=mp4,mov,webm
VIDEO_MAX_SIZE_BYTES=5368709120
VIDEO_MAX_DURATION_SEC=14400
CLIP_MIN_DURATION_SEC=5
CLIP_MAX_DURATION_SEC=180
STALE_UPLOAD_THRESHOLD_SEC=86400
STALE_UPLOAD_CLEANUP_INTERVAL_SEC=3600

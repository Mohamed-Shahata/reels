generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum VideoStatus {
  UPLOADING
  UPLOADED
  PROCESSING
  READY
  FAILED
  DELETING
}

enum ContentType {
  PODCAST
  SOLO
}

enum ClipSource {
  MANUAL
  AI
}

enum ClipStatus {
  DRAFT
  READY
}

enum VideoLayout {
  AUTO
  STACKED
}

enum JobType {
  INGEST
  TRANSCRIBE
  SEGMENT
  ANALYZE
  RENDER
  CLEANUP
}

enum JobStatus {
  QUEUED
  RUNNING
  RETRYING
  COMPLETED
  FAILED
  CANCELLED
}

enum AssetKind {
  SOURCE
  AUDIO
  PROXY
  POSTER
  THUMB
  RENDER
  SUBTITLE_FILE
}

enum MediaAssetStatus {
  PENDING
  READY
  DELETING
  DELETED
}

model User {
  id               String            @id @default(cuid())
  email            String            @unique
  passwordHash     String
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  videos           Video[]
  sessions         Session[]
  usageRecords     UsageRecord[]
  processingJobs   ProcessingJob[]
  segmentationRuns SegmentationRun[]
  mediaAssets      MediaAsset[]
}

model Session {
  id               String   @id @default(cuid())
  userId           String
  refreshTokenHash String
  expiresAt        DateTime
  createdAt        DateTime @default(now())
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Video {
  id               String            @id @default(cuid())
  userId           String
  title            String
  contentType      ContentType       @default(SOLO)
  durationSec      Float?
  sizeBytes        BigInt?
  status           VideoStatus       @default(UPLOADING)
  failedStage      JobType?
  language         String            @default("ar")
  autoClips        Boolean           @default(false)
  deletedAt        DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  clips            Clip[]
  processingJobs   ProcessingJob[]
  transcript       Transcript?
  segmentationRuns SegmentationRun[]
  mediaAssets      MediaAsset[]
  reframePlan      ReframePlan?

  @@index([userId])
}

model Clip {
  id           String       @id @default(cuid())
  videoId      String
  title        String
  startSec     Float
  endSec       Float
  source       ClipSource   @default(MANUAL)
  status       ClipStatus   @default(DRAFT)
  layout       VideoLayout  @default(AUTO)
  score        Float?
  reason       String?
  thumbnailUrl String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  video        Video        @relation(fields: [videoId], references: [id], onDelete: Cascade)
  renders      ClipRender[]
  mediaAssets  MediaAsset[]

  @@index([videoId])
}

model UsageRecord {
  id              String   @id @default(cuid())
  userId          String
  monthStart      DateTime
  uploadedSeconds Float    @default(0)
  clipCount       Int      @default(0)
  aiRunCount      Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, monthStart])
  @@index([userId, monthStart])
}

model ProcessingJob {
  id             String      @id @default(cuid())
  userId         String
  videoId        String?
  type           JobType
  status         JobStatus   @default(QUEUED)
  idempotencyKey String?     @unique
  bullJobId      String?     @unique
  progress       Int         @default(0)
  attempt        Int         @default(0)
  maxAttempts    Int         @default(3)
  lockedBy       String?
  heartbeatAt    DateTime?
  errorCode      String?
  lastError      String?
  payload        Json?
  startedAt      DateTime?
  completedAt    DateTime?
  failedAt       DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  video          Video?      @relation(fields: [videoId], references: [id], onDelete: Cascade)
  clipRender     ClipRender?
  events         JobEvent[]

  @@index([userId, status])
  @@index([videoId])
  @@index([status, createdAt])
}

model JobEvent {
  id      String        @id @default(cuid())
  jobId   String
  at      DateTime      @default(now())
  level   String        @default("INFO")
  message String
  data    Json?
  job     ProcessingJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, at])
}

model OutboxEvent {
  id          String    @id @default(cuid())
  routingKey  String
  payload     Json
  createdAt   DateTime  @default(now())
  publishedAt DateTime?
  attempts    Int       @default(0)

  @@index([publishedAt, createdAt])
}

model MediaAsset {
  id          String           @id @default(cuid())
  userId      String
  videoId     String?
  clipId      String?
  kind        AssetKind
  storageKey  String           @unique
  sizeBytes   BigInt?
  contentType String?
  status      MediaAssetStatus @default(PENDING)
  expiresAt   DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  video       Video?           @relation(fields: [videoId], references: [id], onDelete: Cascade)
  clip        Clip?            @relation(fields: [clipId], references: [id], onDelete: Cascade)
  clipRenders ClipRender[]

  @@index([userId])
  @@index([videoId])
  @@index([clipId])
  @@index([status, expiresAt])
}

model ReframePlan {
  id           String      @id @default(cuid())
  videoId      String      @unique
  version      Int         @default(1)
  contentType  ContentType @default(SOLO)
  faces        Json
  speakerTurns Json?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  video        Video       @relation(fields: [videoId], references: [id], onDelete: Cascade)
}

model Transcript {
  id        String              @id @default(cuid())
  videoId   String              @unique
  language  String
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  video     Video               @relation(fields: [videoId], references: [id], onDelete: Cascade)
  segments  TranscriptSegment[]
}

model TranscriptSegment {
  id           String     @id @default(cuid())
  transcriptId String
  startSec     Float
  endSec       Float
  text         String
  words        Json?
  speaker      String?
  createdAt    DateTime   @default(now())
  transcript   Transcript @relation(fields: [transcriptId], references: [id], onDelete: Cascade)

  @@index([transcriptId, startSec])
}

model SegmentationRun {
  id                String   @id @default(cuid())
  userId            String
  videoId           String
  clipCount         Int
  replacedClipCount Int      @default(0)
  segments          Json
  createdAt         DateTime @default(now())
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  video             Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([videoId, createdAt])
  @@index([userId, createdAt])
}

model ClipRender {
  id              String         @id @default(cuid())
  clipId          String
  processingJobId String?        @unique
  assetId         String?
  startSec        Float
  endSec          Float
  outputUrl       String?
  subtitleStyle   Json?
  subtitleCues    Json?
  subtitleEdits   Json?
  subtitleKey     String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  clip            Clip           @relation(fields: [clipId], references: [id], onDelete: Cascade)
  processingJob   ProcessingJob? @relation(fields: [processingJobId], references: [id], onDelete: Cascade)
  asset           MediaAsset?    @relation(fields: [assetId], references: [id], onDelete: SetNull)

  @@index([clipId, createdAt])
}

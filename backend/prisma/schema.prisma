generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum VideoStatus {
  UPLOADING
  READY
  FAILED
}

enum ClipSource {
  MANUAL
  AI
}

enum ProcessingJobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum ProcessingJobType {
  TRANSCRIPTION
  RENDER
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  videos       Video[]
  sessions     Session[]
  usageRecords UsageRecord[]
  processingJobs ProcessingJob[]
  segmentationRuns SegmentationRun[]
}

model Session {
  id               String   @id @default(cuid())
  userId           String
  refreshTokenHash String
  expiresAt        DateTime
  createdAt        DateTime @default(now())
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Video {
  id           String      @id @default(cuid())
  userId       String
  title        String
  cloudinaryId String?     @unique
  durationSec  Float?
  sizeBytes    BigInt?
  status       VideoStatus @default(UPLOADING)
  language     String      @default("ar")
  autoClips    Boolean     @default(false)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  clips        Clip[]
  processingJobs ProcessingJob[]
  transcript   Transcript?
  segmentationRuns SegmentationRun[]

  @@index([userId])
}

model Clip {
  id        String     @id @default(cuid())
  videoId   String
  title     String
  startSec  Float
  endSec    Float
  source    ClipSource @default(MANUAL)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  video     Video      @relation(fields: [videoId], references: [id], onDelete: Cascade)
  renders   ClipRender[]

  @@index([videoId])
}

model UsageRecord {
  id              String   @id @default(cuid())
  userId          String
  monthStart      DateTime
  uploadedSeconds Float    @default(0)
  clipCount       Int      @default(0)
  aiRunCount      Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, monthStart])
  @@index([userId, monthStart])
}

model ProcessingJob {
  id          String              @id @default(cuid())
  userId      String
  videoId     String?
  type        ProcessingJobType
  status      ProcessingJobStatus @default(PENDING)
  bullJobId   String?             @unique
  progress    Int                 @default(0)
  attempts    Int                 @default(0)
  lastError   String?
  payload     Json?
  startedAt   DateTime?
  completedAt DateTime?
  failedAt    DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  video       Video?              @relation(fields: [videoId], references: [id], onDelete: Cascade)
  clipRender  ClipRender?

  @@index([userId, status])
  @@index([videoId])
  @@index([status, createdAt])
}

model Transcript {
  id          String              @id @default(cuid())
  videoId     String              @unique
  language    String
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  video       Video               @relation(fields: [videoId], references: [id], onDelete: Cascade)
  segments    TranscriptSegment[]
}

model TranscriptSegment {
  id           String     @id @default(cuid())
  transcriptId String
  startSec     Float
  endSec       Float
  text         String
  words        Json?
  createdAt    DateTime   @default(now())
  transcript   Transcript @relation(fields: [transcriptId], references: [id], onDelete: Cascade)

  @@index([transcriptId, startSec])
}

model SegmentationRun {
  id                String   @id @default(cuid())
  userId            String
  videoId           String
  clipCount         Int
  replacedClipCount Int      @default(0)
  segments          Json
  createdAt         DateTime @default(now())
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  video             Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([videoId, createdAt])
  @@index([userId, createdAt])
}

model ClipRender {
  id              String         @id @default(cuid())
  clipId          String
  processingJobId String?        @unique
  startSec        Float
  endSec          Float
  outputUrl       String?
  subtitleStyle   Json?
  subtitleCues    Json?
  subtitleEdits   Json?
  subtitleKey     String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  clip            Clip           @relation(fields: [clipId], references: [id], onDelete: Cascade)
  processingJob   ProcessingJob? @relation(fields: [processingJobId], references: [id], onDelete: Cascade)

  @@index([clipId, createdAt])
}
